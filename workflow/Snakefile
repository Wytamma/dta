        """

rule trait_through_time:
    """Prevalence over time and the emergence date (TMRCA) of every state."""
    input:
        # per-chain files: each chain loses its own burn-in prefix
        trees=CHAIN_TREES,
        trait_json=f"{NAME}.traits.json",
        scripts=scripts("trait_through_time.py", "trait_trees.py", "dates.py", "trait_data.py"),
    output:
        prevalence=PREVALENCE,
        tmrca=TMRCA,
        tmrca_samples=TMRCA_SAMPLES,
    conda:
        ENVS_DIR / "python.yml"
    params:
        tag=ID_PREFIX,
        burnin_fraction=BURNIN_FRACTION,
        mrsd=f"--mrsd {MRSD}" if MRSD else "",
    shell:
        """
        python {SCRIPTS_DIR}/trait_through_time.py \
            --trees {input.trees} \
            --tag {params.tag} \
            --trait-json {input.trait_json} \
            --burnin-fraction {params.burnin_fraction} \
            --output-prefix {NAME} \
            {params.mrsd}
        """

rule plot_trait_through_time:
    input:
        prevalence=PREVALENCE,
        tmrca=TMRCA,
        tmrca_samples=TMRCA_SAMPLES,
        acquisitions=ACQUISITIONS,
        scripts=scripts("plot_events.py"),
    output:
        THROUGH_TIME_PNG,
    conda:
        ENVS_DIR / "python.yml"
    shell:
        """
        python {SCRIPTS_DIR}/plot_events.py through_time \
            --prevalence {input.prevalence} \
            --tmrca {input.tmrca} \
            --tmrca-samples {input.tmrca_samples} \
            --acquisitions {input.acquisitions} \
            --output {output} \
            --title "{TRAIT_NAME} prevalence over time"
        """

rule plot_trait_arrivals:
    """Prevalence plus when each state was entered (survives paraphyly)."""
    input:
        prevalence=PREVALENCE,
        events=EVENTS,
        acquisitions=ACQUISITIONS,
        tmrca=TMRCA,
        scripts=scripts("plot_events.py"),
    output:
        ARRIVALS_PNG,
    conda:
        ENVS_DIR / "python.yml"
    shell:
        """
        python {SCRIPTS_DIR}/plot_events.py arrivals \
            --prevalence {input.prevalence} \
            --events {input.events} \
            --acquisitions {input.acquisitions} \
            --tmrca {input.tmrca} \
            --output {output} \
            --title "{TRAIT_NAME} prevalence and arrivals"
        """

rule plot_root_states:
    input:
        root_states=ROOT_STATES,
        scripts=scripts("plot_events.py"),
    output:
        f"{NAME}.root_states.png",
    conda:
        ENVS_DIR / "python.yml"
    shell:
        """
        python {SCRIPTS_DIR}/plot_events.py root \
            --root-states {input.root_states} --output {output} \
            --title "{TRAIT_NAME} root state"
        """